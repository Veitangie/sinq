$PRE{
    -- Earlier responses stay available by request number: 2 is the stock check.
    local stock = sinq.responses[2].json().stock
    req.skip(stock < 2)
}
POST ${env.BASE_URL}/inventory/reserve
Authorization: Bearer ${AUTH_TOKEN}
Content-Type: application/json

{
    "sku": "health_potion",
    "qty": 2
}

$ASSERT{ sinq.assert.code(200, "Failed to reserve stock") }
