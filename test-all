#!/usr/bin/env bash

failed=()

if ! go test -race -shuffle=on -coverprofile=coverage.txt ./...; then
  failed+=("tests")
fi

for pkg in $(go list ./...); do
  for target in $(go test "$pkg" -list='^Fuzz' | grep '^Fuzz'); do
    echo "=== fuzzing $pkg $target for ${1:-30s} ($(date '+%H:%M:%S'))"
    if ! go test -run='^$' -fuzz="^${target}\$" -fuzztime=${1:-30s} "$pkg"; then
      failed+=("$pkg $target")
    fi
  done
done

if [ ${#failed[@]} -ne 0 ]; then
  echo
  echo "FAILED:"
  printf '  %s\n' "${failed[@]}"
  exit 1
fi
echo "All tests and fuzz targets passed ($(date '+%H:%M:%S'))"
